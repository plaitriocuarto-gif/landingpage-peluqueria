# Copiá este archivo como .env y completá los valores reales

# Servidor
JWT_SECRET=cambia_esto_en_produccion
SETUP_SECRET=clave_para_crear_admin
PORT=3001

# Vercel
VERCEL_TOKEN=
VERCEL_URL=https://tu-proyecto.vercel.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk (autenticación)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Resend (emails transaccionales)
RESEND_API_KEY=

# Mercado Pago (pagos — requerido para el checkout)
# Obtené tu Access Token en: https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=APP_USR-...tu-access-token-de-produccion

# PLaiT
# Precio en ARS (sin centavos). Ej: 15000 = $15.000 ARS
PLAIT_PRICE=15000
BASE_URL=https://turnosonlineplait.com
